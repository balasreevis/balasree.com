<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ title or site.name }}</title>
    {% set metaDescription = (description or excerpt or (portfolio.about.body[0] if portfolio.about.body) or site.description) | truncate(160) %}
    {% set metaImage = image or portfolio.about.image %}
    {% if metaDescription %}<meta name="description" content="{{ metaDescription }}" />{% endif %}
    <link rel="alternate" type="application/atom+xml" title="{{ blog.title or site.name }}" href="/feed.xml" />
    <link rel="stylesheet" href="/assets/styles.css" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="{{ site.name }}" />
    <meta property="og:title" content="{{ title or site.name }}" />
    <meta property="og:url" content="{{ page.url | absoluteUrl(site.url) }}" />
    {% if metaDescription %}<meta property="og:description" content="{{ metaDescription }}" />{% endif %}
    {% if metaImage %}<meta property="og:image" content="{{ metaImage | absoluteUrl(site.url) }}" />{% endif %}

    <meta name="twitter:card" content="{{ 'summary_large_image' if metaImage else 'summary' }}" />
    <meta name="twitter:title" content="{{ title or site.name }}" />
    {% if metaDescription %}<meta name="twitter:description" content="{{ metaDescription }}" />{% endif %}
    {% if metaImage %}<meta name="twitter:image" content="{{ metaImage | absoluteUrl(site.url) }}" />{% endif %}
  </head>
  <body>
    {% include "partials/header.njk" %}
    <main>
      {{ content | safe }}
    </main>
    {% include "partials/footer.njk" %}
    <script src="/assets/smooth-scroll.js" defer></script>
    <script src="/assets/word-ticker.js" defer></script>
    <script src="/assets/nav-toggle.js" defer></script>
  </body>
</html>
