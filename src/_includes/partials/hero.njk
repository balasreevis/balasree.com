<section class="hero">
  <div class="hero-media">
    {% photo portfolio.hero.image, portfolio.hero.imageAlt, { loading: "eager", widths: [640, 1000, 1600, 2400, 3200] } %}
  </div>
  <div class="container">
    <div class="hero-text">
      <h1>{{ portfolio.hero.title }}</h1>
      <p class="lead">{{ portfolio.hero.subtitle }}</p>
      {% if portfolio.hero.cta %}
        <a class="btn" href="{{ portfolio.hero.cta.href }}">{{ portfolio.hero.cta.label }}</a>
      {% endif %}
    </div>
  </div>
</section>
