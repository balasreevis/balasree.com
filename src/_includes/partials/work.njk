<section class="section moments" id="moments">
  <div class="container">
    <header class="section-head">
      <h2>{{ portfolio.moments.title }}</h2>
      {% if portfolio.moments.subtitle %}<p class="muted">{{ portfolio.moments.subtitle }}</p>{% endif %}
    </header>
    <ul class="moments-grid">
      {% for item in collections.workItems %}
        <li class="moments-card">
          <a href="{{ item.data.href }}">
            <div class="moments-media">
              <img src="{{ item.data.image }}" alt="{{ item.data.imageAlt }}" loading="lazy" />
            </div>
            <div class="moments-meta">
              <h3>{{ item.data.title }}</h3>
              {% if item.data.category %}<p class="muted">{{ item.data.category }}</p>{% endif %}
            </div>
          </a>
        </li>
      {% endfor %}
    </ul>
  </div>
</section>
