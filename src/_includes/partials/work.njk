<section class="section work" id="work">
  <div class="container">
    <header class="section-head">
      <h2>{{ portfolio.work.title }}</h2>
      {% if portfolio.work.subtitle %}<p class="muted">{{ portfolio.work.subtitle }}</p>{% endif %}
    </header>
    <ul class="work-grid">
      {% for item in collections.workItems %}
        <li class="work-card">
          <a href="{{ item.data.href }}">
            <div class="work-media">
              <img src="{{ item.data.image }}" alt="{{ item.data.imageAlt }}" loading="lazy" />
            </div>
            <div class="work-meta">
              <h3>{{ item.data.title }}</h3>
              {% if item.data.category %}<p class="muted">{{ item.data.category }}</p>{% endif %}
            </div>
          </a>
        </li>
      {% endfor %}
    </ul>
  </div>
</section>
